<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cl.duoc.dsy1102.timecapsule.HelloController"
      spacing="14" style="-fx-padding: 10;">
    <Label text="Cápsula del Tiempo" />
    <TableView fx:id="tablaMensajes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colAutor" text="Autor" />
            <TableColumn fx:id="colTexto" text="Mensaje" />
            <TableColumn fx:id="colPlazo" text="Leer dentro de" />
            <TableColumn fx:id="colPorcentaje" text=" % " />
        </columns>
    </TableView>
</VBox>
