<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>

<VBox xmlns:fx="http://javafx.com"
      fx:controller="cl.duoc.dsy1102.timecapsule.HelloController"
      spacing="16"
      stylesheets="@estilo.css">

    <!-- Título Moderno -->
    <Label text="⏳ Cápsula del Tiempo"
           style="-fx-font-size: 22px; -fx-font-weight: 700; -fx-text-fill: #1e293b;" />

    <!-- Formulario de Entrada -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="campoAutor" promptText="Tu nombre"
                   style="-fx-background-radius: 6px; -fx-border-radius: 6px; -fx-border-color: #cbd5e1; -fx-padding: 8px 12px; -fx-pref-width: 140px;"/>

        <TextField fx:id="campoTexto" promptText="Mensaje para el futuro" HBox.hgrow="ALWAYS"
                   style="-fx-background-radius: 6px; -fx-border-radius: 6px; -fx-border-color: #cbd5e1; -fx-padding: 8px 12px;"/>

        <ComboBox fx:id="campoPlazo" promptText="Plazo"
                  style="-fx-background-radius: 6px; -fx-border-radius: 6px; -fx-border-color: #cbd5e1; -fx-padding: 4px; -fx-pref-width: 130px;"/>

        <ComboBox fx:id="campoPorcentaje" promptText="Porcentaje"
                  style="-fx-background-radius: 6px; -fx-border-radius: 6px; -fx-border-color: #cbd5e1; -fx-padding: 4px; -fx-pref-width: 110px;"/>

        <Button text="Guardar mensaje" onAction="#agregarMensaje"
                style="-fx-background-color: linear-gradient(to bottom right, #4f46e5, #4338ca); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 9px 16px; -fx-cursor: hand;" />
    </HBox>

    <!-- Mensaje de Estado -->
    <Label fx:id="estadoRegistro" text=""
           style="-fx-font-size: 13px; -fx-text-fill: #059669; -fx-font-weight: 500;" />

    <!-- Tabla Estilizada con Distribución Automática -->
    <TableView fx:id="tablaMensajes" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colAutor" text="Autor" />
            <TableColumn fx:id="colTexto" text="Mensaje" />
            <TableColumn fx:id="colPlazo" text="Leer dentro de"  />
            <TableColumn fx:id="colPorcentaje" text="Porcentaje"  />
        </columns>
    </TableView>
</VBox>
